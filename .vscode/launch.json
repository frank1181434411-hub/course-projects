{
    "version":"0.2.0",
    "configurations":[
        {
            "name":"Debug Qt SimplePaint",
            "type":"cppdbg",
            "request":"launch",
            "program":"${workspaceFolder}\\debug\\SimplePaint.exe",
            "args":[],
            "stopAtEntry":false,
            "cwd":"${workspaceFolder}",
            "environment":[
                {
                    "name":"PATH",
                    "value":"D:\\msys2\\ucrt64\\bin;${env:PATH}"
                }
            ],
            "externalConsole":false,
            "MIMode":"gdb",
            "miDebuggerPath":"D:/msys2/ucrt64/bin/gdb.exe",
            "preLaunchTask":"mingw32-make",
            "setupCommands":[
                {
                    "description":"为 gdb 启用整齐打印",
                    "text":"-enable-pretty-printing",
                    "ignoreFailures":true
                },
                {
                    "description":"将反汇编风格设置为 Intel",
                    "text":"-gdb-set disassembly-flavor intel",
                    "ignoreFailures":true
                }
            ]
        }
    ]
}